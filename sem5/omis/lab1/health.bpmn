        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TestsNotRequired_di" bpmnElement="Flow_TestsNotRequired">
        <di:waypoint x="1540" y="623" />
        <di:waypoint x="1785" y="623" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1656" y="598" width="17" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TestsToResults_di" bpmnElement="Flow_TestsToResults">
        <di:waypoint x="1760" y="868" />
        <di:waypoint x="1820" y="868" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ResultsToDoctor_di" bpmnElement="Flow_ResultsToDoctor">
        <di:waypoint x="2000" y="868" />
        <di:waypoint x="2070" y="868" />
        <di:waypoint x="2070" y="780" />
        <di:waypoint x="1170" y="780" />
        <di:waypoint x="1170" y="666" />
        <di:waypoint x="1320" y="666" />
