<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_HealthCertificate" targetNamespace="http://example.com/omis/health-certificate" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.30.1">
  <collaboration id="Collaboration_HealthCertificate">
    <participant id="Participant_HealthCertificate" name="Получение справки о состоянии здоровья" processRef="Process_HealthCertificate" />
  </collaboration>
  <process id="Process_HealthCertificate" name="Получение справки о состоянии здоровья" isExecutable="false">
    <laneSet id="LaneSet_HealthCertificate">
      <lane id="Lane_Laboratory" name="Лаборатория">
        <flowNodeRef>Task_PerformTests</flowNodeRef>
        <flowNodeRef>Task_SendResults</flowNodeRef>
      </lane>
      <lane id="Lane_Doctor" name="Врач">
        <flowNodeRef>Task_ConductExamination</flowNodeRef>
        <flowNodeRef>Gateway_TestsRequired</flowNodeRef>
        <flowNodeRef>Task_IssueCertificate</flowNodeRef>
        <flowNodeRef>Task_IssueRefusal</flowNodeRef>
        <flowNodeRef>Task_IssueCertificateWithRestrictions</flowNodeRef>
        <flowNodeRef>Gateway_RestrictionsFound</flowNodeRef>
        <flowNodeRef>Gateway_CertificateIssuable</flowNodeRef>
      </lane>
      <lane id="Lane_Registry" name="Регистратура">
        <flowNodeRef>Task_VerifyIdentity</flowNodeRef>
        <flowNodeRef>Task_CheckDocuments</flowNodeRef>
        <flowNodeRef>Gateway_DocumentsComplete</flowNodeRef>
        <flowNodeRef>Task_ScheduleExamination</flowNodeRef>
        <flowNodeRef>Task_NotifyRefusal</flowNodeRef>
        <flowNodeRef>Task_RegisterCertificate</flowNodeRef>
      </lane>
      <lane id="Lane_Applicant" name="Заявитель">
        <flowNodeRef>Start_NeedCertificate</flowNodeRef>
        <flowNodeRef>Task_SubmitApplication</flowNodeRef>
        <flowNodeRef>Task_PayService</flowNodeRef>
        <flowNodeRef>Task_SignConsent</flowNodeRef>
        <flowNodeRef>Task_AttendExamination</flowNodeRef>
        <flowNodeRef>Gateway_RepeatRequested</flowNodeRef>
        <flowNodeRef>Task_ReceiveCertificate</flowNodeRef>
        <flowNodeRef>End_CertificateReceived</flowNodeRef>
        <flowNodeRef>End_ProcessClosed</flowNodeRef>
        <flowNodeRef>Task_CorrectDocuments</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_NeedCertificate" name="Возникла необходимость получить справку">
      <outgoing>Flow_StartToSubmit</outgoing>
    </startEvent>
    <userTask id="Task_SubmitApplication" name="Подать заявление и документы">
      <incoming>Flow_StartToSubmit</incoming>
      <incoming>Flow_CorrectedToCheck</incoming>
    </userTask>
    <serviceTask id="Task_VerifyIdentity" name="Проверить личность заявителя">
      <incoming>Flow_SubmitToIdentityCheck</incoming>
      <outgoing>Flow_IdentityToDocumentCheck</outgoing>
    </serviceTask>
    <serviceTask id="Task_CheckDocuments" name="Проверить документы и данные заявителя">
      <incoming>Flow_IdentityToDocumentCheck</incoming>
      <outgoing>Flow_CheckToGateway</outgoing>
    </serviceTask>
    <exclusiveGateway id="Gateway_DocumentsComplete" name="Документы полные и корректные?">
      <incoming>Flow_CheckToGateway</incoming>
      <outgoing>Flow_DocumentsIncomplete</outgoing>
      <outgoing>Flow_DocumentsComplete</outgoing>
    </exclusiveGateway>
    <userTask id="Task_ScheduleExamination" name="Назначить дату медицинского осмотра">
      <incoming>Flow_DocumentsComplete</incoming>
      <outgoing>Flow_ScheduleToPayment</outgoing>
    </userTask>
    <userTask id="Task_PayService" name="Оплатить медицинское обследование">
      <incoming>Flow_ScheduleToPayment</incoming>
      <outgoing>Flow_PaymentToConsent</outgoing>
    </userTask>
    <userTask id="Task_SignConsent" name="Подписать согласие на обследование">
      <incoming>Flow_PaymentToConsent</incoming>
      <outgoing>Flow_ConsentToAttend</outgoing>
    </userTask>
    <userTask id="Task_AttendExamination" name="Явиться в медицинское учреждение">
      <incoming>Flow_ConsentToAttend</incoming>
      <outgoing>Flow_AttendToExamination</outgoing>
    </userTask>
    <userTask id="Task_ConductExamination" name="Провести медицинский осмотр">
      <incoming>Flow_AttendToExamination</incoming>
      <incoming>Flow_ResultsToDoctor</incoming>
      <outgoing>Flow_ExaminationToTests</outgoing>
    </userTask>
    <exclusiveGateway id="Gateway_TestsRequired" name="Нужны дополнительные анализы?">
      <incoming>Flow_ExaminationToTests</incoming>
      <outgoing>Flow_TestsRequired</outgoing>
      <outgoing>Flow_TestsNotRequired</outgoing>
    </exclusiveGateway>
    <userTask id="Task_PerformTests" name="Провести необходимые анализы">
      <incoming>Flow_TestsRequired</incoming>
      <outgoing>Flow_TestsToResults</outgoing>
    </userTask>
    <serviceTask id="Task_SendResults" name="Передать результаты врачу">
      <incoming>Flow_TestsToResults</incoming>
      <outgoing>Flow_ResultsToDoctor</outgoing>
    </serviceTask>
    <serviceTask id="Task_IssueCertificate" name="Оформить справку о состоянии здоровья">
      <incoming>Flow_NoRestrictions</incoming>
      <outgoing>Flow_IssuedToRegister</outgoing>
    </serviceTask>
    <serviceTask id="Task_NotifyRefusal" name="Сообщить заявителю об отказе">
      <incoming>Flow_RefusalToNotify</incoming>
      <outgoing>Flow_NotifyToRepeatChoice</outgoing>
    </serviceTask>
    <exclusiveGateway id="Gateway_RepeatRequested" name="Заявитель хочет повторить обследование?">
      <incoming>Flow_NotifyToRepeatChoice</incoming>
      <outgoing>Flow_RepeatRequested</outgoing>
      <outgoing>Flow_RepeatNotRequested</outgoing>
    </exclusiveGateway>
    <serviceTask id="Task_RegisterCertificate" name="Зарегистрировать и подготовить справку">
      <incoming>Flow_1cppnvm</incoming>
      <outgoing>Flow_RegisterToReceive</outgoing>
    </serviceTask>
    <userTask id="Task_ReceiveCertificate" name="Получить справку">
      <incoming>Flow_RegisterToReceive</incoming>
      <outgoing>Flow_ReceiveToEnd</outgoing>
    </userTask>
    <endEvent id="End_CertificateReceived" name="Справка получена">
      <incoming>Flow_ReceiveToEnd</incoming>
    </endEvent>
    <endEvent id="End_ProcessClosed" name="Процесс завершен без выдачи справки">
      <incoming>Flow_RepeatNotRequested</incoming>
    </endEvent>
    <userTask id="Task_CorrectDocuments" name="Исправить или дополнить документы">
      <incoming>Flow_DocumentsIncomplete</incoming>
      <outgoing>Flow_CorrectedToCheck</outgoing>
    </userTask>
    <serviceTask id="Task_IssueRefusal" name="Оформить отказ в выдаче справки">
      <incoming>Flow_CertificateNotIssuable</incoming>
      <outgoing>Flow_RefusalToNotify</outgoing>
    </serviceTask>
    <serviceTask id="Task_IssueCertificateWithRestrictions" name="Оформить справку с ограничениями">
      <incoming>Flow_CertificateIssuable</incoming>
      <incoming>Flow_IssuedToRegister</incoming>
      <outgoing>Flow_1cppnvm</outgoing>
    </serviceTask>
    <exclusiveGateway id="Gateway_RestrictionsFound" name="Выявлены ограничения по здоровью?">
      <incoming>Flow_TestsNotRequired</incoming>
      <incoming>Flow_ResultsToDoctor</incoming>
      <outgoing>Flow_RestrictionsFound</outgoing>
      <outgoing>Flow_NoRestrictions</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="Gateway_CertificateIssuable" name="Справку можно выдать с ограничениями?">
      <incoming>Flow_RestrictionsFound</incoming>
      <outgoing>Flow_CertificateIssuable</outgoing>
      <outgoing>Flow_CertificateNotIssuable</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="Flow_StartToSubmit" sourceRef="Start_NeedCertificate" targetRef="Task_SubmitApplication" />
    <sequenceFlow id="Flow_CorrectedToCheck" sourceRef="Task_CorrectDocuments" targetRef="Task_SubmitApplication" />
    <sequenceFlow id="Flow_SubmitToIdentityCheck" sourceRef="Task_SubmitApplication" targetRef="Task_VerifyIdentity" />
    <sequenceFlow id="Flow_IdentityToDocumentCheck" sourceRef="Task_VerifyIdentity" targetRef="Task_CheckDocuments" />
    <sequenceFlow id="Flow_CheckToGateway" sourceRef="Task_CheckDocuments" targetRef="Gateway_DocumentsComplete" />
    <sequenceFlow id="Flow_DocumentsIncomplete" name="нет" sourceRef="Gateway_DocumentsComplete" targetRef="Task_CorrectDocuments" />
    <sequenceFlow id="Flow_DocumentsComplete" name="да" sourceRef="Gateway_DocumentsComplete" targetRef="Task_ScheduleExamination" />
    <sequenceFlow id="Flow_RepeatRequested" name="да" sourceRef="Gateway_RepeatRequested" targetRef="Task_ScheduleExamination" />
    <sequenceFlow id="Flow_ScheduleToPayment" sourceRef="Task_ScheduleExamination" targetRef="Task_PayService" />
    <sequenceFlow id="Flow_PaymentToConsent" sourceRef="Task_PayService" targetRef="Task_SignConsent" />
    <sequenceFlow id="Flow_ConsentToAttend" sourceRef="Task_SignConsent" targetRef="Task_AttendExamination" />
    <sequenceFlow id="Flow_AttendToExamination" sourceRef="Task_AttendExamination" targetRef="Task_ConductExamination" />
    <sequenceFlow id="Flow_ResultsToDoctor" sourceRef="Task_SendResults" targetRef="Task_ConductExamination" />
    <sequenceFlow id="Flow_ExaminationToTests" sourceRef="Task_ConductExamination" targetRef="Gateway_TestsRequired" />
    <sequenceFlow id="Flow_TestsRequired" name="да" sourceRef="Gateway_TestsRequired" targetRef="Task_PerformTests" />
    <sequenceFlow id="Flow_TestsNotRequired" name="нет" sourceRef="Gateway_TestsRequired" targetRef="Gateway_RestrictionsFound" />
    <sequenceFlow id="Flow_TestsToResults" sourceRef="Task_PerformTests" targetRef="Task_SendResults" />
    <sequenceFlow id="Flow_NoRestrictions" name="нет" sourceRef="Gateway_RestrictionsFound" targetRef="Task_IssueCertificate" />
    <sequenceFlow id="Flow_IssuedToRegister" sourceRef="Task_IssueCertificate" targetRef="Task_IssueCertificateWithRestrictions" />
    <sequenceFlow id="Flow_RefusalToNotify" sourceRef="Task_IssueRefusal" targetRef="Task_NotifyRefusal" />
    <sequenceFlow id="Flow_NotifyToRepeatChoice" sourceRef="Task_NotifyRefusal" targetRef="Gateway_RepeatRequested" />
    <sequenceFlow id="Flow_RepeatNotRequested" name="нет" sourceRef="Gateway_RepeatRequested" targetRef="End_ProcessClosed" />
    <sequenceFlow id="Flow_1cppnvm" sourceRef="Task_IssueCertificateWithRestrictions" targetRef="Task_RegisterCertificate" />
    <sequenceFlow id="Flow_RegisterToReceive" sourceRef="Task_RegisterCertificate" targetRef="Task_ReceiveCertificate" />
    <sequenceFlow id="Flow_ReceiveToEnd" sourceRef="Task_ReceiveCertificate" targetRef="End_CertificateReceived" />
    <sequenceFlow id="Flow_CertificateNotIssuable" name="нет" sourceRef="Gateway_CertificateIssuable" targetRef="Task_IssueRefusal" />
    <sequenceFlow id="Flow_CertificateIssuable" name="да" sourceRef="Gateway_CertificateIssuable" targetRef="Task_IssueCertificateWithRestrictions" />
    <sequenceFlow id="Flow_RestrictionsFound" name="да" sourceRef="Gateway_RestrictionsFound" targetRef="Gateway_CertificateIssuable" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_HealthCertificate">
    <bpmndi:BPMNPlane id="BPMNPlane_HealthCertificate" bpmnElement="Collaboration_HealthCertificate">
