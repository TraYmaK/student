="Преподаватель_преподает_предметы_в_группах" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="178"/><column index="2" value="194"/><column index="3" value="113"/><column index="4" value="131"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="Студенческая_группа" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="178"/><column index="2" value="131"/><column index="3" value="150"/><column index="4" value="167"/><column index="5" value="142"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">SELECT DISTINCT
    t4.Номер_аудитории,
    t2.Название_предмета,
	t3.Название_группы
FROM Преподаватель_преподает_предметы_в_группах AS t4
JOIN Предмет AS t2
ON t4.Кодовый_номер_предмета = t2.Кодовый_номер_предмета
JOIN Студенческая_группа AS t3
ON t4.Кодовый_номер_группы = t3.Кодовый_номер_группы
WHERE t4.Номер_аудитории BETWEEN 100 AND 200</sql><current_tab id="0"/></tab_sql></sqlb_project>
